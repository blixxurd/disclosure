---
import type { FileMetadataView } from '../lib/types.js';

interface Props {
  metadata: FileMetadataView;
}

const { metadata } = Astro.props;

interface Row { label: string; value: string }

const rows: Row[] = [];
const push = (label: string, value: string | number | null) => {
  if (value !== null && value !== undefined && value !== '') {
    rows.push({ label, value: String(value) });
  }
};

push('Pages', metadata.pdf_pages);
push('Creator', metadata.pdf_creator);
push('Producer', metadata.pdf_producer);
push('PDF created', metadata.pdf_created_at);
push('PDF modified', metadata.pdf_modified_at);
if (metadata.pdf_encrypted === 1) {
  push('Encryption', metadata.pdf_permissions ?? 'AES-256');
}
if (metadata.pdf_is_scan === 1) push('Page type', 'Scanned (no text layer)');
push('Dimensions', metadata.width && metadata.height ? `${metadata.width} × ${metadata.height}` : null);
push('Software', metadata.exif_software);
if (metadata.duration_seconds != null) push('Duration', `${metadata.duration_seconds.toFixed(1)} s`);
push('Codec', metadata.video_codec);
push('Frame rate', metadata.video_fps ? `${metadata.video_fps} fps` : null);
---

{rows.length > 0 && (
  <dl
    class="grid gap-x-4 gap-y-1 text-sm"
    style="grid-template-columns: max-content 1fr; font-family: var(--font-mono); font-size: 0.78rem;"
  >
    {rows.map((row) => (
      <>
        <dt class="label-mono" style="color: var(--color-faint);">{row.label}</dt>
        <dd style="color: var(--color-fg); word-break: break-word;">{row.value}</dd>
      </>
    ))}
  </dl>
)}
