{
  "name": "disclosure",
  "version": "0.1.0",
  "private": true,
  "description": "UFO/UAP disclosure archive monorepo",
  "scripts": {
    "download": "pnpm --filter @disclosure/downloader run dev",
    "index": "pnpm --filter @disclosure/indexer run dev --ocr",
    "index:fast": "pnpm --filter @disclosure/indexer run dev",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9"
}
