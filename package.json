{
  "name": "disclosure",
  "version": "0.1.0",
  "private": true,
  "description": "UFO/UAP disclosure archive — downloader, indexer, classifier (and webapp)",
  "scripts": {
    "refresh": "pnpm download && pnpm index && pnpm classify",
    "download": "pnpm --filter @disclosure/downloader run dev",
    "index": "pnpm --filter @disclosure/indexer run dev --ocr",
    "index:fast": "pnpm --filter @disclosure/indexer run dev",
    "classify": "pnpm --filter @disclosure/classifier run dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "render": "node scripts/render-html.mjs",
    "web": "pnpm --filter @disclosure/web run dev"
  },
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "marked": "^18.0.3",
    "vitest": "^4.1.5"
  }
}
